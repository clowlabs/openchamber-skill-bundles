{
  "name": "skill-bundles",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "description": "Turn OpenCode skills on and off in named bundles.",
  "bin": {
    "skills": "bin/skills"
  },
  "scripts": {
    "build": "cp status/meter.css panel/meter.css && openchamber-guest-bundle panel/main.ts panel/main.js && openchamber-guest-bundle status/main.ts status/main.js",
    "test": "node --test test/ && bun test test/panel-io.test.js",
    "test:panel": "bun test test/panel-io.test.js",
    "check": "bash scripts/check.sh",
    "lint": "biome lint --config-path=lint.jsonc .",
    "lint:fix": "biome lint --write --config-path=lint.jsonc .",
    "typecheck": "tsc --noEmit --strict --target es2022 --moduleResolution bundler --module esnext --resolveJsonModule --lib es2022,dom,dom.iterable panel/main.ts status/main.ts shared/panel/*.ts"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.7.1",
    "@biomejs/biome": "2.6.4",
    "typescript": "5.9.3"
  },
  "openchamber": {
    "apiVersion": 1,
    "id": "skill-bundles",
    "name": "Skill Bundles",
    "icon": "stack",
    "contributes": {
      "panel": {
        "entry": "panel/index.html"
      },
      "page": true,
      "capabilities": [
        "sessions"
      ],
      "filesystem": [
        "~/.config/opencode/skill-bundles.json",
        "~/.config/opencode/opencode.json",
        "~/.config/opencode/opencode.json.skill-bundles-*",
        "~/.config/opencode/skills/**",
        "~/.claude/skills/**",
        "~/.agents/skills/**",
        "~/.config/opencode/.skill-bundles.lock",
        "~/**/.opencode/skills/**",
        "/**/.opencode/skills/**",
        "~/**/.opencode/opencode.json",
        "/**/.opencode/opencode.json",
        "~/**/.opencode/opencode.json.skill-bundles-rescue-*",
        "/**/.opencode/opencode.json.skill-bundles-rescue-*"
      ],
      "statusSection": {
        "entry": "status/index.html",
        "title": "Skills",
        "height": 72
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nightshine8/openchamber-skill-bundles"
  },
  "homepage": "https://github.com/nightshine8/openchamber-skill-bundles#readme"
}
